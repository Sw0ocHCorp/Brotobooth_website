{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brotobooth",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*", "/acompte/*", "/agenda/*", "/demo"]
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brotobooth",
      "database_id": "99ac8bbe-6724-4fcf-b327-a2afa4896f5d",
      "migrations_dir": "migrations"
    }
  ],
  // Le site ne répond que sur brotobooth.fr : ni l'adresse de secours workers.dev, ni les adresses d'aperçu, que
  // Cloudflare Access ne protège pas (l'application Access porte sur brotobooth.fr).
  "workers_dev": false,
  "preview_urls": false,
  // Le domaine du site : la publication le rattache au Worker, et Cloudflare crée son entrée DNS.
  "routes": [{ "pattern": "brotobooth.fr", "custom_domain": true }],
  // ACCESS_TEAM_DOMAIN : le domaine de l'équipe Cloudflare Access, dont les clés signent le jeton du propriétaire.
  "vars": { "BASE_URL": "https://brotobooth.fr", "ACCESS_TEAM_DOMAIN": "dawn-brook-8805.cloudflareaccess.com" },
  "access": {
    "dev": {
      "aud": "local-dev",
      "identity": { "email": "owner@example.test" }
    }
  }
}

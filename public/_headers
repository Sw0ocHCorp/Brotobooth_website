# Les en-têtes des fichiers statiques. Le Worker met les mêmes sur ses réponses (worker/http.ts, DEFAULT_HEADERS) :
# les changer ici, c'est les changer là, et test/worker/headers.test.ts les compare.
# `same-origin` comme sur les pages du Worker : leurs formulaires ont besoin de l'en-tête Origin.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; connect-src 'self'; form-action 'self' https://checkout.stripe.com; frame-ancestors 'none'; base-uri 'self'
  X-Content-Type-Options: nosniff
  Referrer-Policy: same-origin

# L'administration n'est pas à indexer, avec ou sans la barre finale que Cloudflare ajoute à un dossier.
/admin
  X-Robots-Tag: noindex
/admin/*
  X-Robots-Tag: noindex

---
/**
 * Le gabarit de toutes les pages du site : la langue, la couleur du navigateur, le titre, la description, la charte
 * (`tokens.css`) et les polices (`fonts.css`), dont les deux plus utilisées sont préchargées pour que le titre et le texte
 * n'attendent pas leur découverte dans la feuille de style. `noindex` écarte la page des moteurs de recherche.
 * `opening` charge `early.js`, de façon bloquante et avant les feuilles de style, sur la page qui joue l'ouverture
 * (l'accueil) : il dit au CSS, avant le premier affichage, si les scripts tournent et si l'ouverture va jouer.
 */
interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  opening?: boolean;
}

const { title, description, noindex = false, opening = false } = Astro.props;
const PRELOADED = ["Outfit-latin-400", "Unbounded-latin-800"];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0B0B0F" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {opening && <script is:inline src="/scripts/early.js"></script>}
    {PRELOADED.map((font) => <link rel="preload" href={`/fonts/${font}.woff2`} as="font" type="font/woff2" crossorigin />)}
    <link rel="stylesheet" href="/styles/tokens.css" />
    <link rel="stylesheet" href="/styles/fonts.css" />
  </head>
  <body>
    <slot />
  </body>
</html>

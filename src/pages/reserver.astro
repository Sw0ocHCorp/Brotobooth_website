---
import { formatEuros } from "../../worker/html";
import { finalDepositPercent, hasContact, offer } from "../../worker/offer";
import ContactLine from "../components/ContactLine.astro";
import TopBar from "../components/TopBar.astro";
import Base from "../layouts/Base.astro";
import "../styles/site.css";
import "../styles/reserver.css";

/**
 * La réservation, dans la carte de la maquette validée (`#res` de `docs/superpowers/specs/2026-11-07-maquette-site.html`),
 * posée sur la vidéo de la borne : la date, la formule, les coordonnées, puis la confirmation. Tous les textes sont ici ;
 * `src/scripts/reservation.ts` construit le calendrier, passe d'une étape à l'autre et montre le message qui convient.
 * Chaque message d'erreur (`problem-<champ>`) se place à côté de ce qu'il concerne ; le nom de chaque champ est celui
 * du corps JSON de `POST /api/requests`, que le script lit sans autre correspondance. Sans JavaScript, la carte donne le
 * téléphone et l'e-mail à la place du calendrier. Une phrase qui invite à nous contacter n'est écrite que si l'offre dit
 * comment (`ContactLine`, `hasContact`) ; les délais, le pourcentage et les limites viennent de `config/offer.json`.
 * `PUBLIC_TURNSTILE_SITE_KEY` : la clé du widget anti-robots. Vide (essais), le widget n'est pas chargé.
 */
type Field = {
  name: string;
  label: string;
  problem: string;
  type?: string;
  autocomplete?: string;
  placeholder?: string;
  maxlength?: number;
  options?: string[];
};

const rows: Field[][] = [
  [
    // Aucun type choisi d'avance : la première option, vide, laisse le champ à remplir (`required`).
    { name: "event_type", label: "Type d'événement", options: offer.eventTypes, problem: "Choisissez le type d'événement." },
    {
      name: "event_hours",
      label: "Horaires de l'événement",
      placeholder: "De 19\u00a0h à 1\u00a0h",
      maxlength: 60,
      problem: "Indiquez les horaires, par exemple de 19\u00a0h à 1\u00a0h.",
    },
  ],
  [{ name: "venue", label: "Lieu", placeholder: "Adresse de l'événement", maxlength: 300, problem: "Indiquez l'adresse de l'événement." }],
  [
    { name: "name", label: "Nom", autocomplete: "name", maxlength: 120, problem: "Indiquez votre nom." },
    { name: "phone", label: "Téléphone", type: "tel", autocomplete: "tel", maxlength: 20, problem: "Vérifiez votre numéro de téléphone." },
  ],
  [{ name: "email", label: "E-mail", type: "email", autocomplete: "email", maxlength: 254, problem: "Vérifiez votre adresse e-mail." }],
];

const STEPS = ["Date", "Formule", "Coordonnées"];
/** « (30 % du prix) », une fois l'offre définitive. */
const share = finalDepositPercent();
const active = offer.maxActivePerEmail;
const several = active > 1 ? "s" : "";
const WEEKDAYS = ["L", "M", "M", "J", "V", "S", "D"];
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<Base
  title="Réserver votre photobooth – Brotobooth"
  description={`Choisissez votre date et votre formule, puis laissez vos coordonnées. Rien à payer maintenant : nous vous répondons sous ${offer.reviewHours} h.`}
>
  <TopBar variant="reserve" />
  <main class="res">
    <video class="film needs-js" muted loop playsinline preload="none" poster="/media/borne-boucle-poster.webp" aria-hidden="true">
      <source src="/media/borne-boucle.mp4" type='video/mp4; codecs="avc1.64001F"' />
    </video>
    <div class="res-veil"></div>

    <div class="res-in">
      <button
        type="button"
        class="film-toggle"
        id="film-toggle"
        aria-label="Mettre la vidéo en pause"
        data-pause="Mettre la vidéo en pause"
        data-play="Relancer la vidéo"
        hidden
      >
        <svg viewBox="0 0 16 16" aria-hidden="true"><path class="pause" d="M4 3h3v10H4zM9 3h3v10H9z" /><path class="play" d="M5 2.5 13.5 8 5 13.5z" /></svg>
      </button>
      <div class="card glass">
        <ol class="crumbs needs-js" id="crumbs" aria-label="Étapes">
          {STEPS.map((step, index) => <li aria-current={index === 0 ? "step" : undefined}>{index + 1}<span aria-hidden="true"> · </span>{step}</li>)}
        </ol>

        <section class="pane" id="step-1" aria-labelledby="step-1-title">
          <h1 id="step-1-title" tabindex="-1">Choisissez votre date</h1>
          <p class="res-note no-js" id="no-js">
            Le calendrier ne s'affiche pas sur votre navigateur. Essayez-en un autre. <ContactLine lead="Pour réserver sans le calendrier, " />
          </p>
          <div id="calendar" class="needs-js">
            <div class="month">
              <button type="button" id="prev" aria-label="Mois précédent">←</button>
              <span id="month-name" aria-live="polite"></span>
              <button type="button" id="next" aria-label="Mois suivant">→</button>
            </div>
            <div class="weekdays" aria-hidden="true">{WEEKDAYS.map((day) => <span>{day}</span>)}</div>
            <div class="days" id="days" role="group" aria-labelledby="month-name" aria-busy="true"></div>
            <p class="legend"><span><i class="swatch"></i>Libre</span><span><s aria-hidden="true">12</s> Déjà réservée</span></p>
            <p class="lead-days">
              En ligne, une date se réserve au moins {offer.minLeadDays}&nbsp;jours à l'avance. <ContactLine lead="Si c'est plus urgent, " />
            </p>
          </div>
          <div id="calendar-down" class="notice needs-js" role="alert" hidden>
            <p>Nous n'arrivons pas à afficher le calendrier pour le moment. <ContactLine /></p>
            <button type="button" class="btn ghost" id="retry">Réessayer</button>
          </div>
          <p class="problem" id="problem-taken" role="alert" tabindex="-1" hidden>
            Cette date vient d'être réservée par quelqu'un d'autre. Choisissez-en une autre&nbsp;: vos informations sont conservées.
          </p>
          <p class="problem" id="problem-date" role="alert" tabindex="-1" hidden>
            Cette date n'est plus disponible à la réservation. Choisissez-en une autre&nbsp;: vos informations sont conservées.
          </p>
          <p class="res-note">
            Rien à payer maintenant. Une fois votre demande envoyée, nous gardons cette date pour vous et nous vous répondons sous {offer.reviewHours}&nbsp;h.
            Si nous pouvons être là, vous recevez par e-mail un lien pour régler l'acompte{share && ` (${share} du prix)`}, et votre date est confirmée dès
            qu'il est payé.
          </p>
          <div class="res-foot needs-js">
            <span id="picked">Aucune date choisie</span>
            <button type="button" class="btn primary" id="go-date" disabled>Continuer</button>
          </div>
        </section>

        <section class="pane" id="step-2" aria-labelledby="step-2-title" hidden>
          <h1 id="step-2-title" tabindex="-1">Choisissez votre formule</h1>
          <div role="group" aria-labelledby="step-2-title">
            {
              offer.plans.map((plan) => (
                <button type="button" class="choice" data-plan={plan.id} aria-pressed="false">
                  <b>{plan.name}</b>
                  {plan.priceCents > 0 && <span>{formatEuros(plan.priceCents)}</span>}
                  {plan.includes.length > 0 && <span class="includes">{plan.includes.join(" · ")}</span>}
                </button>
              ))
            }
          </div>
          <p class="problem" id="problem-plan" role="alert" tabindex="-1" hidden>Cette formule n'est plus proposée. Choisissez-en une autre.</p>
          <div class="res-foot">
            <button type="button" class="link" data-back="1"><span aria-hidden="true">←</span> Retour</button>
            <button type="button" class="btn primary" id="go-plan" disabled>Continuer</button>
          </div>
        </section>

        <form class="pane" id="step-3" aria-labelledby="step-3-title" novalidate hidden>
          <h1 id="step-3-title" tabindex="-1">Vos coordonnées</h1>
          {
            rows.map((row) => (
              <div class:list={{ two: row.length > 1 }}>
                {row.map((field) => (
                  <div class="fld">
                    <label for={`f-${field.name}`}>{field.label}</label>
                    {field.options ? (
                      <select id={`f-${field.name}`} name={field.name} required>
                        <option value="">Choisir…</option>
                        {field.options.map((option) => (
                          <option>{option}</option>
                        ))}
                      </select>
                    ) : (
                      <input
                        id={`f-${field.name}`}
                        name={field.name}
                        type={field.type ?? "text"}
                        autocomplete={field.autocomplete}
                        placeholder={field.placeholder}
                        maxlength={field.maxlength}
                        required
                      />
                    )}
                    <p class="problem" id={`problem-${field.name}`} hidden>
                      {field.problem}
                    </p>
                  </div>
                ))}
              </div>
            ))
          }
          <label class="check">
            <input type="checkbox" id="f-terms" name="terms" required />
            <span>J'accepte les <a href="/cgv" target="_blank" rel="noopener">conditions générales de vente</a>.</span>
          </label>
          <p class="problem" id="problem-terms" hidden>Acceptez les conditions générales de vente pour envoyer votre demande.</p>
          <div id="turnstile" data-sitekey={turnstileKey}></div>
          <div id="send-problem" class="notice" role="alert" tabindex="-1" hidden>
            <p data-problem="failed">Votre demande n'a pas pu partir. Vos informations sont conservées&nbsp;: réessayez dans un instant.</p>
            <p data-problem="bot">La vérification de sécurité n'a pas abouti. Vos informations sont conservées&nbsp;: réessayez dans un instant.</p>
            {/* Une demande en cours attend notre réponse, ou, acceptée, son acompte : la phrase vaut pour les deux. */}
            <p data-problem="too_many">
              Vous avez déjà {active} demande{several} en cours. Terminons d'abord celle{several}-ci&nbsp;: nous vous répondons sous {offer.reviewHours}&nbsp;h,
              puis vous réglez l'acompte. Vous pourrez ensuite en envoyer une nouvelle.
            </p>
            <p data-problem="too_many_ip">
              Nous ne pouvons pas enregistrer de nouvelle demande depuis cette connexion pour le moment. Réessayez demain{
                hasContact() ? ", ou contactez-nous pour réserver dès maintenant" : ""
              }.
            </p>
            <ContactLine />
          </div>
          <div class="res-foot">
            <button type="button" class="link" data-back="2"><span aria-hidden="true">←</span> Retour</button>
            <button type="submit" class="btn primary" id="send">Envoyer ma demande</button>
          </div>
        </form>

        <section class="pane" id="step-4" aria-labelledby="step-4-title" hidden>
          <h1 id="step-4-title" tabindex="-1">
            <span data-outcome="created" hidden>Merci, votre demande est envoyée&nbsp;!</span>
            <span data-outcome="already_requested" hidden>Votre demande nous est déjà parvenue</span>
          </h1>
          <p class="res-note" data-outcome="created" hidden>
            Nous gardons le <span data-chosen></span> pour vous et vous répondons sous {offer.reviewHours}&nbsp;h. Un e-mail vient de partir avec le récapitulatif de votre
            demande. Si vous ne voyez pas l'e-mail, regardez dans vos courriers indésirables.
          </p>
          <p class="res-note" data-outcome="already_requested" hidden>
            Votre demande pour le <span data-chosen></span> est bien enregistrée, inutile de la renvoyer. Vous trouverez dans vos e-mails son récapitulatif, puis
            notre réponse.
          </p>
          <a class="btn ghost" href="/">Retour à l'accueil</a>
        </section>
      </div>
    </div>
  </main>
</Base>

<script>
  import "../scripts/reservation";
</script>

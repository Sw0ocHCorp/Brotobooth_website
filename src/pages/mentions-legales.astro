---
import Fact from "../components/Fact.astro";
import Legal from "../layouts/Legal.astro";
import { offer, telHref } from "../../worker/offer";

/** Le téléphone et l'e-mail de `config/offer.json`, avec leur lien ; `Fact` met le marqueur à la place d'un moyen encore vide. */
const { phone, email } = offer.contact;
---

<Legal title="Mentions légales" description="Qui édite le site Brotobooth, qui l'héberge, et comment nous joindre.">
  <h1>Mentions légales</h1>
  <p class="meta">Qui est derrière ce site, qui l'héberge et comment nous joindre.</p>

  <section aria-labelledby="editeur">
    <h2 id="editeur">Éditeur du site</h2>
    <p>Ce site est édité par l'entreprise suivante.</p>
    <dl>
      <dt>Dénomination</dt>
      <dd><Fact /></dd>
      <dt>Forme juridique</dt>
      <dd><Fact /></dd>
      <dt>SIRET</dt>
      <dd><Fact /></dd>
      <dt>Adresse</dt>
      <dd><Fact /></dd>
      <dt>Directeur de la publication</dt>
      <dd><Fact /></dd>
    </dl>
  </section>

  <section aria-labelledby="hebergeur">
    <h2 id="hebergeur">Hébergeur</h2>
    <p>
      Le site est hébergé par Cloudflare. La base de données qui garde les demandes de réservation est hébergée dans l'Union européenne.
    </p>
    <dl>
      <dt>Coordonnées de l'hébergeur</dt>
      <dd><Fact /></dd>
    </dl>
  </section>

  <section aria-labelledby="contact">
    <h2 id="contact">Contact</h2>
    <dl>
      <dt>Téléphone</dt>
      <dd><Fact value={phone} href={telHref(phone)} /></dd>
      <dt>E-mail</dt>
      <dd><Fact value={email} href={`mailto:${email}`} /></dd>
    </dl>
  </section>

  <section aria-labelledby="donnees">
    <h2 id="donnees">Données personnelles et cookies</h2>
    <p>
      Ce que nous faisons de vos données est expliqué dans notre <a href="/confidentialite">politique de confidentialité</a>. Ce site ne dépose
      aucun cookie de suivi ni de mesure d'audience.
    </p>
  </section>

  <section aria-labelledby="propriete">
    <h2 id="propriete">Propriété intellectuelle</h2>
    <p>
      Le logo, les textes, les photographies et les vidéos de ce site sont ceux de Brotobooth. Vous ne pouvez ni les reproduire ni les réutiliser
      sans notre accord écrit.
    </p>
  </section>
</Legal>

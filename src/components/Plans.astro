---
import { formatEuros } from "../../worker/html";
import { isBookable, offer, plansOf } from "../../worker/offer";

/**
 * « Les formules » (`#formules`), telles que `config/offer.json` les décrit : une carte par borne, avec ce qu'elle comprend
 * une fois renseigné. Une borne réservable donne ses nombres de tirages et leurs prix (aucun montant tant qu'une formule
 * est encore à 0 €), puis un seul lien qui ouvre la réservation sur elle : le nombre de tirages se choisit ensuite. Une
 * borne encore sans formule le dit en toutes lettres, sans lien.
 */
---

<section class="block" id="formules">
  <div class="head"><h2>Les formules</h2></div>
  <div class="plans">
    {
      offer.booths.map((booth) => (
        <article class="plan">
          <h3>{booth.name}</h3>
          {booth.includes.length > 0 && (
            <ul class="includes">
              {booth.includes.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          )}
          {isBookable(offer, booth.id) ? (
            <>
              <ul class="prints">
                {plansOf(offer, booth.id).map((plan) => (
                  <li>
                    <span>{plan.prints} tirages</span>
                    {plan.priceCents > 0 && <b class="price">{formatEuros(plan.priceCents)}</b>}
                  </li>
                ))}
              </ul>
              <a class="btn ghost" href={`/reserver?borne=${encodeURIComponent(booth.id)}`}>
                Choisir le {booth.name}
              </a>
            </>
          ) : (
            <p class="soon">Bientôt disponible.</p>
          )}
        </article>
      ))
    }
  </div>
</section>

---
import { contactLinks, offer } from "../../worker/offer";
import ContactAnchor from "./ContactAnchor.astro";
import ContactFallback from "./ContactFallback.astro";

/**
 * « Contact » (`#contact`), la dernière section de l'accueil : le formulaire de `POST /api/contact`, puis, sous lui, les
 * moyens directs renseignés dans `config/offer.json` (un appel par fondateur, WhatsApp et Instagram en icônes, tout autre
 * réseau écrit court), chacun absent tant qu'il est vide, annoncés par « Vous pouvez aussi nous contacter : ». Tous les textes sont ici ; `src/scripts/contact.ts` envoie le message, charge l'anti-robots au
 * premier champ touché et montre ce qui convient. Comme à la réservation, le message d'un champ refusé (`problem-<champ>`)
 * est sous lui, et le nom de chaque champ est celui du corps JSON. Le formulaire part caché et le script le montre une
 * fois prêt à l'envoyer : sans lui (JavaScript coupé, script qui n'arrive pas), le navigateur l'enverrait lui-même et le
 * message serait perdu ; `method="post"` garde alors au moins nom, e-mail et message hors de toute adresse. Sans
 * JavaScript, une phrase renvoie vers WhatsApp à sa place (`ContactFallback`, comme après un envoi refusé) ; sans WhatsApp,
 * vers l'adresse e-mail. `PUBLIC_TURNSTILE_SITE_KEY` : la clé du widget
 * anti-robots ; vide (essais), il n'est pas chargé.
 */
const { email, whatsapp } = offer.contact;
const means = contactLinks(offer.contact, ({ name }) => `Appeler ${name}`);

type Field = { name: string; label: string; problem: string; type?: string; autocomplete?: string; maxlength: number; optional?: boolean };
const fields: Field[] = [
  { name: "name", label: "Votre nom", autocomplete: "name", maxlength: 120, problem: "Indiquez votre nom." },
  { name: "email", label: "Votre e-mail", type: "email", autocomplete: "email", maxlength: 254, problem: "Vérifiez votre adresse e-mail." },
  {
    name: "phone",
    label: "Votre téléphone (facultatif)",
    type: "tel",
    autocomplete: "tel",
    maxlength: 20,
    optional: true,
    problem: "Vérifiez votre numéro de téléphone.",
  },
  { name: "message", label: "Votre message", maxlength: 2000, problem: "Écrivez votre message." },
];
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY ?? "";
---

<section class="block contact-section" id="contact" aria-labelledby="contact-title">
  <div class="contact-in">
    <h2 id="contact-title">Contact</h2>
    <p class="contact-lead">Une question sur la borne ou sur votre événement&nbsp;? Écrivez-nous, nous vous répondons par e-mail.</p>

    <form class="contact-form" id="contact-form" method="post" novalidate hidden>
      {
        fields.map((field) => (
          <div class="fld">
            <label for={`f-${field.name}`}>{field.label}</label>
            {field.name === "message" ? (
              <textarea id={`f-${field.name}`} name={field.name} maxlength={field.maxlength} rows="6" required />
            ) : (
              <input
                id={`f-${field.name}`}
                name={field.name}
                type={field.type ?? "text"}
                autocomplete={field.autocomplete}
                maxlength={field.maxlength}
                required={!field.optional}
              />
            )}
            <p class="problem" id={`problem-${field.name}`} hidden>
              {field.problem}
            </p>
          </div>
        ))
      }
      <div id="turnstile" data-sitekey={turnstileKey}></div>
      <div id="send-problem" class="notice" role="alert" tabindex="-1" hidden>
        <p data-problem="failed">Votre message n'est pas parti. Vérifiez votre connexion, puis réessayez. <ContactFallback /></p>
        <p data-problem="bot">La vérification anti-robots n'a pas abouti. Réessayez.</p>
        <p data-problem="too_many">Beaucoup de messages sont partis de cette connexion aujourd'hui. Réessayez demain. <ContactFallback /></p>
      </div>
      <button type="submit" class="btn ghost" id="send">Envoyer le message</button>
      <p class="privacy">
        Brotobooth utilise votre nom, votre e-mail, votre téléphone et votre message uniquement pour vous répondre, et les efface au bout de
        12&nbsp;mois. Vos droits et le détail&nbsp;: <a href="/confidentialite#contact">politique de confidentialité</a>.
      </p>
    </form>
    <p class="sent" id="sent" tabindex="-1" hidden>Merci, votre message est bien parti. Nous vous répondons par e-mail.</p>
    <p class="no-js">
      Le formulaire ne s'affiche pas sur votre navigateur. {
        whatsapp ? (
          <ContactFallback />
        ) : email ? (
          <>
            Écrivez-nous à <a href={`mailto:${email}`}>{email}</a>.
          </>
        ) : (
          "Essayez-en un autre."
        )
      }
    </p>
    {
      means.length > 0 && (
        <div class="means-block">
          <p>Vous pouvez aussi nous contacter&nbsp;:</p>
          <ul class="means">
            {means.map((link) => (
              <li>
                <ContactAnchor link={link} class="btn ghost" />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

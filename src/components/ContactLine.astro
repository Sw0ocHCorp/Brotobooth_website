---
import { offer } from "../../worker/offer";

/**
 * « Appelez-nous au … ou écrivez-nous à … », avec les moyens de contact renseignés dans `config/offer.json` : la phrase
 * se réduit à celui qui existe, et disparaît si aucun ne l'est (offre provisoire). C'est ce que la réservation propose
 * quand elle ne peut pas aboutir en ligne.
 */
const { phone, email } = offer.contact;
const parts = [
  ...(phone ? [{ lead: "Appelez-nous au ", href: `tel:${phone.replace(/[^\d+]/g, "")}`, label: phone }] : []),
  ...(email ? [{ lead: phone ? " ou écrivez-nous à " : "Écrivez-nous à ", href: `mailto:${email}`, label: email }] : []),
];
---

{parts.length > 0 && <span class="contact">{parts.map(({ lead, href, label }) => <>{lead}<a href={href}>{label}</a></>)}.</span>}

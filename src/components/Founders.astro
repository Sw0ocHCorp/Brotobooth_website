---
import Shot from "./Shot.astro";

/**
 * La présentation des fondateurs, avec leur vraie photo prise par la borne : ce que le client reçoit d'eux, une borne
 * faite de leurs mains et installée chez lui (texte confirmé par le propriétaire le 2026-11-09).
 */
---

<section class="block founders">
  <Shot
    name="fondateurs"
    width={1000}
    height={750}
    tilt="-2.4deg"
    from={-1}
    alt="Les deux fondateurs dos à dos, photographiés par la borne"
  />
  <div>
    <blockquote>Une borne construite de nos mains, que nous venons installer chez vous.</blockquote>
    <p>
      Nous avons construit cette borne nous-mêmes, du meuble en bois au logiciel. Nous l'installons chez vous, sur le lieu
      de votre événement.
    </p>
  </div>
</section>

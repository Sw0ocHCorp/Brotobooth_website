---
import Shot from "./Shot.astro";

/**
 * La présentation des fondateurs, avec leur vraie photo prise par la borne. Le texte reste à confirmer par le
 * propriétaire (spec, section 13).
 */
---

<section class="block founders">
  <Shot
    name="fondateurs"
    width={1000}
    height={750}
    tilt="-2.4deg"
    from={-1}
    alt="Les deux fondateurs dos à dos, photographiés par la borne"
  />
  <div>
    <blockquote>On lance notre premier photobooth&nbsp;!</blockquote>
    <p>
      Nous avons construit cette borne nous-mêmes, du meuble en bois au logiciel. C'est notre première, et nous venons
      l'installer chez vous.
    </p>
  </div>
</section>

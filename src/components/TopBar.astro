---
import Logo from "../../logo-blanc.svg";

/**
 * La barre du site, fixée en haut : le logo, qui ramène à l'accueil, puis le menu. Sur les pages de la vitrine (`home`),
 * le menu mène à la borne, aux formules, au contact et à la réservation ; sur la réservation (`reserve`), il se réduit à
 * « Accueil » et la barre reste claire au-dessus de la vidéo, jusqu'à ce que la carte défile sous elle. Ailleurs, elle
 * est voilée pour rester lisible au-dessus des sections ; sur l'accueil avec JavaScript, elle part claire au-dessus de
 * l'ouverture (`#hero`, le CSS le sait dès le premier affichage par `html.js`), et son script la voile (`veiled`) quand
 * elle la quitte. Le menu (`.reveal`) apparaît avec le contenu à la fin de l'animation du logo.
 */
interface Props {
  variant: "home" | "reserve";
}

const { variant } = Astro.props;
const MENUS = {
  home: [
    { href: "/#borne", label: "La borne" },
    { href: "/#formules", label: "Formules" },
    { href: "/#contact", label: "Contact" },
    { href: "/reserver", label: "Réserver" },
  ],
  reserve: [{ href: "/", label: "Accueil" }],
};
---

<header class:list={["bar", { clear: variant === "reserve" }]}>
  <a class="logo" href="/" aria-label="Brotobooth, accueil"><Logo aria-hidden="true" /></a>
  <nav class="reveal" aria-label="Menu principal">
    {MENUS[variant].map(({ href, label }) => <a href={href}>{label}</a>)}
  </nav>
</header>

<script>
  const bar = document.querySelector<HTMLElement>(".bar");
  const hero = document.getElementById("hero");
  // Claire au-dessus de l'ouverture, jusqu'aux 70 % de sa hauteur ; au-dessus de la vidéo, tant que rien ne défile dessous.
  const clearUntil = hero ? () => hero.offsetHeight * 0.7 : bar?.classList.contains("clear") ? () => 1 : null;
  if (bar && clearUntil) {
    const update = () => bar.classList.toggle("veiled", scrollY >= clearUntil());
    update();
    addEventListener("scroll", update, { passive: true });
    addEventListener("resize", update);
  }
</script>

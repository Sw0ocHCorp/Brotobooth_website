---
/**
 * Une vraie photo posée comme un tirage : cadre blanc, inclinée de `tilt` (`--r`), sa place de repos. L'animation des
 * sections la lancera depuis le côté `from` (-1 la gauche, 1 la droite) ; sans elle, la photo est déjà à sa place.
 * Toutes sont sous l'ouverture : chargées à l'approche, et en 800 px sur un téléphone (`scripts/build-media.sh`).
 */
interface Props {
  name: string;
  width: number;
  height: number;
  alt: string;
  tilt: string;
  from: -1 | 1;
}

const PHONE_WIDTH = 800;
const { name, width, height, alt, tilt, from } = Astro.props;
const src = `/media/${name}.webp`;
---

<figure class="shot" style={`--r: ${tilt}`} data-from={from}>
  <img
    src={src}
    srcset={`/media/${name}-${PHONE_WIDTH}.webp ${PHONE_WIDTH}w, ${src} ${width}w`}
    sizes="(max-width: 760px) 100vw, 50vw"
    width={width}
    height={height}
    alt={alt}
    loading="lazy"
    decoding="async"
  />
</figure>

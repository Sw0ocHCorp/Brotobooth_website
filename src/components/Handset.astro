---
import Shot from "./Shot.astro";

/**
 * « Des moments qui subliment votre événement » : ce que la borne réserve aux invités au-delà des photos, le combiné et ses
 * messages audio-vidéo d'abord, puis le cadre et les filtres. Seulement ce qu'elle sait faire aujourd'hui : qui réserve pour
 * dans deux semaines doit pouvoir compter sur chaque ligne.
 */
const MOMENTS = [
  { title: "Un combiné sur le côté", text: "Vos invités décrochent et se laissent des messages audio-vidéo, à écouter directement à la borne" },
  { title: "Un cadre à votre image", text: "Préparez-le avant le jour J, il apparaît sur les tirages" },
  { title: "Filtres et dessin", text: "Vos invités personnalisent leur photo à l'écran" },
];
---

<section class="block handset">
  <div class="handset-in">
    <div>
      <h2>Des moments qui subliment votre événement</h2>
      <p>Au-delà des photos, la borne réserve d'autres surprises à vos invités. Chacune crée un moment à part, qui sublime votre événement.</p>
      <ul class="extras">
        {
          MOMENTS.map(({ title, text }) => (
            <li>
              <b>{title}</b>
              <span>{text}</span>
            </li>
          ))
        }
      </ul>
    </div>
    <Shot
      name="gros-combine"
      width={1500}
      height={844}
      tilt="-1.6deg"
      from={1}
      alt="Le combiné et le bac d'impression sur le côté de la borne"
    />
  </div>
</section>

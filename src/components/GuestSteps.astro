---
import Shot from "./Shot.astro";

/**
 * « Ce que vivent vos invités » (`#borne`) : quatre étapes, chacune avec un vrai écran de la borne ou une vraie photo.
 * Photo et texte changent de côté à chaque étape, et chaque photo arrivera du côté où elle se pose.
 */
const STEPS = [
  {
    image: { name: "ecran-pose", width: 1400, height: 788, tilt: "-2deg", alt: "L'écran de la borne pendant le compte à rebours" },
    over: "La prise de vue",
    title: "Ils prennent la pose",
    text: "Un compte à rebours à l'écran leur laisse le temps de se placer, seuls ou en groupe.",
  },
  {
    image: { name: "ecran-3photos", width: 1400, height: 788, tilt: "1.6deg", alt: "Les trois photos proposées par la borne" },
    over: "La prise de vue",
    title: "Clic, clic, clic",
    text: "Trois photos à la suite pour ne pas rater le bon moment. Ils gardent leur préférée.",
  },
  {
    image: { name: "ecran-format", width: 1400, height: 788, tilt: "-1.2deg", alt: "Le choix du format d'impression sur la borne" },
    over: "L'impression",
    title: "Ils choisissent leur format",
    text: "10×15 ou 15×20, avec un filtre ou un dessin s'ils en ont envie.",
  },
  {
    image: { name: "gros-tirages", width: 1500, height: 844, tilt: "2.2deg", alt: "Deux tirages tenus devant la borne" },
    over: "Le tirage",
    title: "Ils repartent avec",
    text: "Le tirage sort de la borne, prêt à emporter. Ils retrouvent aussi leur photo sur leur téléphone.",
  },
];
---

<section class="block" id="borne">
  <div class="head"><h2>Ce que vivent vos invités</h2></div>
  <ol class="steps-list" role="list">
    {
      STEPS.map(({ image, over, title, text }, index) => (
        <li class="step">
          <Shot {...image} from={index % 2 === 0 ? -1 : 1} />
          <div>
            <span class="over">{over}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>

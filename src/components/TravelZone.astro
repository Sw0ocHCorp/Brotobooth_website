---
import zone from "../generated/zone.json";
import { offer } from "../../worker/offer";
import ContactFallback from "./ContactFallback.astro";

/**
 * « Où nous venons » (`#zone`) : la carte de la zone où nous installons la borne, tracée en SVG en ligne à partir de
 * `src/generated/zone.json` (`npm run zone`), donc sans requête chez le visiteur. La mer est le fond de la section, les
 * communes voisines des traits discrets, la zone une seule forme pleine. La carte est une image (`role="img"`) dont
 * l'`aria-label` donne la zone en toutes lettres ; la phrase à côté ne cite aucun nom, la carte les porte. Les repères
 * écrits sur la carte (leur côté, ceux qui restent sur une carte étroite) viennent de `zone.json` ; voir `.zone-map`
 * dans `site.css`. La question « Votre événement a lieu ailleurs ? » n'est posée que s'il y a un moyen de répondre.
 */
const { viewBox, zone: area, context, labels, updated } = zone;
const { whatsapp, phone, email } = offer.contact;
const canContact = Boolean(whatsapp || phone || email);
// « 2026-11 » → « novembre 2026 ».
const [year, month] = updated.split("-").map(Number);
const asOf = new Intl.DateTimeFormat("fr-FR", { month: "long", year: "numeric", timeZone: "UTC" }).format(Date.UTC(year, month - 1, 1));
const OFFSET = 14;
---

<section class="block" id="zone">
  <div class="head"><h2>Où nous venons</h2></div>
  <div class="zone-in">
    <div class="zone-text">
      <p>Nous installons la borne partout dans la zone dessinée sur la carte, sur la côte comme dans les terres.</p>
      {
        canContact && (
          <p>
            Votre événement a lieu ailleurs&nbsp;? <ContactFallback ending={"\u00a0: nous voyons ensemble ce qui est possible."} />
          </p>
        )
      }
    </div>
    <figure class="zone-map">
      <svg
        viewBox={viewBox}
        role="img"
        aria-label="Carte de la zone où nous installons la borne : de Cassis et Aubagne jusqu'à Hyères et La Londe-les-Maures, sur la côte et dans les terres jusqu'à Gémenos, Cuges-les-Pins, Signes, Méounes, Belgentier, Solliès-Toucas, La Farlède et La Crau."
        focusable="false"
      >
        <path class="context" d={context}></path>
        <path class="area" d={area}></path>
        {
          labels.map(({ name, x, y, side, small }) => (
            <g class={small ? "small" : undefined}>
              <circle cx={x} cy={y}></circle>
              <text x={side === "left" ? x - OFFSET : x + OFFSET} y={y} text-anchor={side === "left" ? "end" : "start"}>{name}</text>
            </g>
          ))
        }
      </svg>
      <figcaption>Contours des communes&nbsp;: IGN, Admin Express (Licence Ouverte), {asOf}</figcaption>
    </figure>
  </div>
</section>

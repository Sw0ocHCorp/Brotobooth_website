{
  "name": "brotobooth-website",
  "version": "0.0.0",
  "private": true,
  "description": "Site vitrine et réservations de Brotobooth (Astro, Cloudflare Worker, D1).",
  "type": "module",
  "scripts": {
    "pretest": "mkdir -p dist",
    "test": "vitest run",
    "build": "astro build",
    "dev": "astro build && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local"
  },
  "dependencies": {
    "stripe": "^23.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.65.0",
    "astro": "^7.4.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}
